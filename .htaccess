# scienceexotic.fr — le navigateur revérifie les pages et scripts à chaque visite (mises à jour visibles tout de suite)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
Options -Indexes
# Adresse inconnue : page « introuvable » du site, qui renvoie vers l'accueil
ErrorDocument 404 /404.html
# Dossier sans page d'accueil (ex. /exerciseurs/, /cours/) : même page, qui renvoie vers l'accueil
ErrorDocument 403 /404.html
